# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ALLOW_STUB_PROVIDERS=false

# AssemblyAI server-side project key
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro

# LLM. ollama keeps the local Qwen path. gemini uses GEMINI_API_KEY.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_THINKING=false

# TTS. kokoro is local. cartesia speaks the verified sentence.
TTS_PROVIDER=kokoro
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3
KOKORO_MODEL_ID=hexgrad/Kokoro-82M
KOKORO_DEVICE=auto

# Persistence and telemetry
DATABASE_PATH=var/lantern.sqlite3
METRICS_DIR=var/metrics

# Existing shared/legacy compatibility paths
VOICE_PROFILE=friendly_waiter
AGENT_MODE=waiter
DANANG_JSON_PATH=legacy/travel/data/knowledge_base.v1.json
CHROMA_PERSIST_DIR=data/chroma
BM25_INDEX_PATH=data/bm25/index.pkl
