# Environments & Secrets (CRITICAL: Never commit real keys)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Node / Frontend Dependencies & Build Output
node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Python Virtual Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
.run/

# Local runtime data, logs, and vector/keyword indexes
var/
legacy/travel/runtime/
*.bin
*.pkl

# Generated report attachments and logs
reports/*.jsonl
reports/*.html
reports/audio/
!reports/.gitkeep
logs/
*.log

# IDE, OS & Editor Artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Model Caches (Local HuggingFace / Sentence Transformers)
.cache/
sentence-transformers/

# SQLite Runtime Artifacts
:memory:.ses
*.ses

# Large source design assets are kept under design/source/ when intentionally versioned.

# Large video masters stay local (GitHub rejects files over 100 MB). The web cut lives in
# landing/public/media/ and is tracked.
/*.mp4
/*.mov
/*.webm
