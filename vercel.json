{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd landing && npm ci",
  "buildCommand": "cd landing && npm run build",
  "outputDirectory": "landing/dist",
  "cleanUrls": true,
  "redirects": [{ "source": "/app", "destination": "/app/", "permanent": false }],
  "headers": [
    {
      "source": "/(media|audio)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(assets|app/assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
